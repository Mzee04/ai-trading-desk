# Claude analyst. Leave this empty to queue survivors for analyst_inbox.py instead.
# auto (config default): Claude when this key is set, external queue when it is not.
# Force a seat without editing config.py:
#   ANALYST_MODE=claude
#   ANALYST_MODE=external
ANTHROPIC_API_KEY=
# ANALYST_MODE=auto

# Optional: a private Solana RPC (Helius, Triton, QuickNode). Public RPC rate-limits fast.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: alerts to your phone
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stocks mode: Alpaca PAPER keys only
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
